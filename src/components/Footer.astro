---
// Footer - 4-column footer with brand, links, legal, contact
---

<footer class="bg-slate-900 text-slate-300 py-16 border-t border-slate-800">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 md:grid-cols-4 gap-12">
            <!-- Column 1: Brand -->
            <div class="col-span-1 md:col-span-1">
                <div class="flex items-center mb-6">
                    <div class="w-8 h-8 rounded-full bg-gradient-to-br from-primary to-secondary flex items-center justify-center text-white mr-2 shadow-sm">
                        <i class="fa-solid fa-hands-holding-child text-sm"></i>
                    </div>
                    <span class="font-extrabold text-xl text-white">BERSAMAJU</span>
                </div>
                <p class="text-sm opacity-80 mb-6">Membuka akses tanpa batas untuk pendidikan inklusif di Indonesia.</p>
                <div class="flex space-x-4">
                    <a href="#" class="w-10 h-10 rounded-full bg-slate-800 flex items-center justify-center hover:bg-primary hover:text-white transition" aria-label="Facebook"><i class="fa-brands fa-facebook-f"></i></a>
                    <a href="#" class="w-10 h-10 rounded-full bg-slate-800 flex items-center justify-center hover:bg-primary hover:text-white transition" aria-label="Instagram"><i class="fa-brands fa-instagram"></i></a>
                    <a href="#" class="w-10 h-10 rounded-full bg-slate-800 flex items-center justify-center hover:bg-primary hover:text-white transition" aria-label="YouTube"><i class="fa-brands fa-youtube"></i></a>
                </div>
            </div>

            <!-- Column 2: Quick Links -->
            <div>
                <h4 class="text-white font-bold mb-6 uppercase text-sm tracking-wider">Tautan Cepat</h4>
                <ul class="space-y-3 text-sm">
                    <li><a href="#tentang" class="hover:text-accent transition">Tentang Kami</a></li>
                    <li><a href="#program" class="hover:text-accent transition">Program Belajar</a></li>
                    <li><a href="#testimoni" class="hover:text-accent transition">Kisah Sukses</a></li>
                    <li><a href="#blog" class="hover:text-accent transition">Blog & Artikel</a></li>
                </ul>
            </div>

            <!-- Column 3: Legal -->
            <div>
                <h4 class="text-white font-bold mb-6 uppercase text-sm tracking-wider">Bantuan & Legal</h4>
                <ul class="space-y-3 text-sm">
                    <li><a href="#" class="hover:text-accent transition">FAQ / Pertanyaan Umum</a></li>
                    <li><a href="#" class="hover:text-accent transition">Kebijakan Privasi</a></li>
                    <li><a href="#" class="hover:text-accent transition">Syarat & Ketentuan</a></li>
                    <li><a href="#" class="hover:text-accent transition">Panduan Aksesibilitas</a></li>
                </ul>
            </div>

            <!-- Column 4: Contact -->
            <div>
                <h4 class="text-white font-bold mb-6 uppercase text-sm tracking-wider">Hubungi Kami</h4>
                <ul class="space-y-4 text-sm">
                    <li class="flex items-start">
                        <i class="fa-solid fa-location-dot mt-1 mr-3 text-accent"></i>
                        <span>Gedung Inklusi, Jl. Pendidikan No. 10, Jakarta Selatan, 12345</span>
                    </li>
                    <li class="flex items-center">
                        <i class="fa-solid fa-envelope mr-3 text-accent"></i>
                        <a href="mailto:halo@bersamaju.id" class="hover:text-white transition">halo@bersamaju.id</a>
                    </li>
                    <li class="flex items-center">
                        <i class="fa-brands fa-whatsapp mr-3 text-accent text-lg"></i>
                        <a href="#" class="hover:text-white transition">+62 811 2233 4455</a>
                    </li>
                </ul>
            </div>
        </div>
        
        <div class="border-t border-slate-800 mt-12 pt-8 text-center text-sm opacity-70">
            <p>&copy; 2026 BERSAMAJU. All rights reserved. Dibangun dengan cinta dan kepedulian.</p>
        </div>
    </div>
</footer>
