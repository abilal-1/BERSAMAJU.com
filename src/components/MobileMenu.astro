---
// MobileMenu - Slide-down mobile navigation
---

<!-- Mobile Menu -->
<div id="mobile-menu" class="md:hidden fixed top-[72px] left-0 w-full bg-white/95 dark:bg-darkbg/95 backdrop-blur-xl border-b border-gray-100 dark:border-gray-800 shadow-xl transform -translate-y-[150%] opacity-0 invisible transition-all duration-500 ease-in-out z-40 rounded-b-3xl">
    <div class="px-6 pt-4 pb-8 space-y-3 flex flex-col text-center">
        <a href="#tentang" class="mobile-nav-link flex items-center justify-center gap-3 px-4 py-4 rounded-2xl text-base font-bold text-gray-700 dark:text-gray-200 bg-gray-50 dark:bg-gray-800/50 hover:bg-blue-50 dark:hover:bg-gray-800 hover:text-primary dark:hover:text-blue-400 transition-colors"><i class="fa-solid fa-circle-info text-primary/70 dark:text-blue-400/70"></i> Tentang Kami</a>
        <a href="#program" class="mobile-nav-link flex items-center justify-center gap-3 px-4 py-4 rounded-2xl text-base font-bold text-gray-700 dark:text-gray-200 bg-gray-50 dark:bg-gray-800/50 hover:bg-green-50 dark:hover:bg-gray-800 hover:text-secondary dark:hover:text-green-400 transition-colors"><i class="fa-solid fa-laptop-code text-secondary/70 dark:text-green-400/70"></i> Program</a>
        <a href="#testimoni" class="mobile-nav-link flex items-center justify-center gap-3 px-4 py-4 rounded-2xl text-base font-bold text-gray-700 dark:text-gray-200 bg-gray-50 dark:bg-gray-800/50 hover:bg-yellow-50 dark:hover:bg-gray-800 hover:text-accent dark:hover:text-yellow-400 transition-colors"><i class="fa-solid fa-star text-accent/70 dark:text-yellow-400/70"></i> Testimoni</a>
        <a href="#blog" class="mobile-nav-link flex items-center justify-center gap-3 px-4 py-4 rounded-2xl text-base font-bold text-gray-700 dark:text-gray-200 bg-gray-50 dark:bg-gray-800/50 hover:bg-pink-50 dark:hover:bg-gray-800 hover:text-pink-500 dark:hover:text-pink-400 transition-colors"><i class="fa-solid fa-newspaper text-pink-500/70 dark:text-pink-400/70"></i> Blog</a>
        <div class="h-px w-full bg-gray-200 dark:bg-gray-700 my-4"></div>
        <button id="mobile-login-btn" class="block w-full px-4 py-4 text-primary dark:text-blue-400 font-bold border-2 border-primary/20 dark:border-blue-400/20 rounded-2xl">Masuk ke Akun</button>
        <button id="mobile-signup-btn" class="block w-full px-4 py-4 bg-gradient-to-r from-accent to-yellow-400 text-slate-900 rounded-2xl font-bold shadow-md mt-2">Daftar Akun Baru</button>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        const mobileMenuBtn = document.getElementById('mobile-menu-btn');
        const mobileMenu = document.getElementById('mobile-menu');
        const menuIconBars = document.getElementById('menu-icon-bars');
        const menuIconClose = document.getElementById('menu-icon-close');
        const mobileLinks = mobileMenu?.querySelectorAll('.mobile-nav-link');

        window.toggleMobileMenu = function(forceClose = false) {
            if (!mobileMenu) return;
            const isHidden = mobileMenu.classList.contains('-translate-y-[150%]');
            
            if (isHidden && !forceClose) {
                mobileMenu.classList.remove('-translate-y-[150%]', 'opacity-0', 'invisible');
                mobileMenu.classList.add('translate-y-0', 'opacity-100', 'visible');
                menuIconBars?.classList.add('hidden');
                menuIconClose?.classList.remove('hidden');
            } else {
                mobileMenu.classList.add('-translate-y-[150%]', 'opacity-0', 'invisible');
                mobileMenu.classList.remove('translate-y-0', 'opacity-100', 'visible');
                menuIconBars?.classList.remove('hidden');
                menuIconClose?.classList.add('hidden');
            }
        };

        mobileMenuBtn?.addEventListener('click', () => window.toggleMobileMenu());

        mobileLinks?.forEach(link => {
            link.addEventListener('click', () => window.toggleMobileMenu(true));
        });

        // Mobile auth buttons
        document.getElementById('mobile-login-btn')?.addEventListener('click', () => {
            window.openModal?.('login');
            window.toggleMobileMenu(true);
        });
        document.getElementById('mobile-signup-btn')?.addEventListener('click', () => {
            window.openModal?.('signup');
            window.toggleMobileMenu(true);
        });
    });
</script>
