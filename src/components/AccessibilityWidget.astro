---
// AccessibilityWidget - Floating button + slide-out panel
---

<!-- Accessibility Floating Button -->
<button id="floating-a11y-btn" class="fixed bottom-6 right-6 z-50 w-14 h-14 bg-primary text-white rounded-full shadow-2xl flex items-center justify-center text-2xl hover:bg-blue-700 transition transform hover:scale-110 focus:ring-4 focus:ring-blue-300" aria-label="Buka Menu Aksesibilitas">
    <i class="fa-solid fa-wheelchair"></i>
</button>

<!-- Accessibility Panel (Right Sidebar) -->
<div id="a11y-panel" class="fixed top-0 right-0 h-full w-80 bg-white dark:bg-darkbg shadow-2xl z-[60] transform translate-x-full opacity-0 transition-all duration-300 overflow-y-auto border-l border-gray-100 dark:border-gray-800">
    <div class="p-6">
        <div class="flex justify-between items-center mb-6 border-b border-gray-100 dark:border-gray-800 pb-4">
            <h3 class="font-bold text-xl text-slate-800 dark:text-white flex items-center">
                <i class="fa-solid fa-universal-access text-primary dark:text-blue-400 mr-2"></i> Aksesibilitas
            </h3>
            <button id="close-a11y-btn" class="text-gray-500 hover:text-red-500 dark:text-gray-400 dark:hover:text-red-400 text-xl w-8 h-8 flex items-center justify-center rounded-full hover:bg-gray-100 dark:hover:bg-gray-800 transition" aria-label="Tutup Menu">
                <i class="fa-solid fa-xmark"></i>
            </button>
        </div>

        <div class="space-y-4">
            <!-- Text Size -->
            <div class="bg-gray-50 dark:bg-gray-800/50 p-4 rounded-2xl border border-gray-100 dark:border-gray-700">
                <label class="block text-sm font-bold text-slate-700 dark:text-gray-300 mb-3">Ukuran Teks</label>
                <div class="flex gap-2">
                    <button id="a11y-increase-text" class="flex-1 bg-white dark:bg-gray-700 hover:bg-blue-50 dark:hover:bg-gray-600 text-slate-800 dark:text-white py-2 rounded-xl font-bold border border-gray-200 dark:border-gray-600 transition shadow-sm" aria-label="Perbesar Teks">A+</button>
                    <button id="a11y-decrease-text" class="flex-1 bg-white dark:bg-gray-700 hover:bg-blue-50 dark:hover:bg-gray-600 text-slate-800 dark:text-white py-2 rounded-xl font-bold border border-gray-200 dark:border-gray-600 transition shadow-sm" aria-label="Perkecil Teks">A-</button>
                </div>
            </div>

            <!-- High Contrast -->
            <div>
                <button id="a11y-high-contrast" class="w-full flex items-center justify-between bg-white dark:bg-gray-800 hover:bg-blue-50 dark:hover:bg-gray-700 text-slate-800 dark:text-white py-3 px-4 rounded-xl font-semibold border-2 border-gray-100 dark:border-gray-700 transition shadow-sm">
                    <span>Kontras Tinggi</span>
                    <i class="fa-solid fa-circle-half-stroke text-gray-400 dark:text-gray-500 transition-colors"></i>
                </button>
            </div>

            <!-- Dyslexia Font -->
            <div>
                <button id="a11y-dyslexia" class="w-full flex items-center justify-between bg-white dark:bg-gray-800 hover:bg-blue-50 dark:hover:bg-gray-700 text-slate-800 dark:text-white py-3 px-4 rounded-xl font-semibold border-2 border-gray-100 dark:border-gray-700 transition shadow-sm">
                    <span>Font Disleksia</span>
                    <i class="fa-solid fa-font text-gray-400 dark:text-gray-500 transition-colors"></i>
                </button>
            </div>

            <!-- Stop Animations -->
            <div>
                <button id="a11y-stop-animation" class="w-full flex items-center justify-between bg-white dark:bg-gray-800 hover:bg-blue-50 dark:hover:bg-gray-700 text-slate-800 dark:text-white py-3 px-4 rounded-xl font-semibold border-2 border-gray-100 dark:border-gray-700 transition shadow-sm">
                    <span>Hentikan Animasi</span>
                    <i class="fa-solid fa-pause text-gray-400 dark:text-gray-500 transition-colors"></i>
                </button>
            </div>
        </div>
        
        <div class="mt-8 pt-6 border-t border-gray-100 dark:border-gray-800">
            <button id="a11y-reset" class="w-full text-sm text-red-500 font-bold hover:underline flex items-center justify-center gap-2">
                <i class="fa-solid fa-rotate-right"></i> Reset Pengaturan
            </button>
        </div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        const floatingA11yBtn = document.getElementById('floating-a11y-btn');
        const closeA11yBtn = document.getElementById('close-a11y-btn');
        const a11yPanel = document.getElementById('a11y-panel');
        
        floatingA11yBtn?.addEventListener('click', (e) => {
            e.preventDefault();
            a11yPanel?.classList.toggle('translate-x-full');
            a11yPanel?.classList.toggle('opacity-0');
        });

        closeA11yBtn?.addEventListener('click', () => {
            a11yPanel?.classList.add('translate-x-full', 'opacity-0');
        });

        // Helper function to toggle button active styling
        function setBtnActiveStyle(btnId: string, isActive: boolean) {
            const btn = document.getElementById(btnId);
            if (!btn) return;
            const icon = btn.querySelector('i');
            if (isActive) {
                btn.classList.add('border-primary', 'bg-blue-50', 'dark:bg-blue-900/30', 'text-primary');
                btn.classList.remove('border-gray-100', 'dark:border-gray-700', 'bg-white', 'dark:bg-gray-800', 'text-slate-800', 'dark:text-white');
                if (icon) {
                    icon.classList.add('text-primary');
                    icon.classList.remove('text-gray-400', 'dark:text-gray-500');
                }
            } else {
                btn.classList.remove('border-primary', 'bg-blue-50', 'dark:bg-blue-900/30', 'text-primary');
                btn.classList.add('border-gray-100', 'dark:border-gray-700', 'bg-white', 'dark:bg-gray-800', 'text-slate-800', 'dark:text-white');
                if (icon) {
                    icon.classList.remove('text-primary');
                    icon.classList.add('text-gray-400', 'dark:text-gray-500');
                }
            }
        }

        // Text size controls
        let currentTextSize = 100;

        document.getElementById('a11y-increase-text')?.addEventListener('click', () => {
            if(currentTextSize < 150) currentTextSize += 10;
            document.documentElement.style.fontSize = currentTextSize + '%';
        });

        document.getElementById('a11y-decrease-text')?.addEventListener('click', () => {
            if(currentTextSize > 80) currentTextSize -= 10;
            document.documentElement.style.fontSize = currentTextSize + '%';
        });

        document.getElementById('a11y-high-contrast')?.addEventListener('click', () => {
            document.documentElement.classList.toggle('a11y-high-contrast');
            const isActive = document.documentElement.classList.contains('a11y-high-contrast');
            setBtnActiveStyle('a11y-high-contrast', isActive);
            
            // Force dark mode if high contrast is active
            if(isActive && !document.documentElement.classList.contains('dark')){
                document.documentElement.classList.add('dark');
                (window as any).updateThemeIcons?.();
            }
        });

        document.getElementById('a11y-dyslexia')?.addEventListener('click', () => {
            document.documentElement.classList.toggle('a11y-dyslexia-font');
            setBtnActiveStyle('a11y-dyslexia', document.documentElement.classList.contains('a11y-dyslexia-font'));
        });

        document.getElementById('a11y-stop-animation')?.addEventListener('click', () => {
            document.documentElement.classList.toggle('a11y-stop-animations');
            setBtnActiveStyle('a11y-stop-animation', document.documentElement.classList.contains('a11y-stop-animations'));
        });

        // Reset button
        document.getElementById('a11y-reset')?.addEventListener('click', () => {
            window.location.reload();
        });
    });
</script>
