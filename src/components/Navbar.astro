---
// Navbar component - Floating pill navbar with desktop/mobile support
---

<!-- Floating Pill Navbar -->
<nav id="navbar" class="fixed z-50 transition-all duration-500 top-0 left-0 w-full rounded-none px-4 py-4 md:top-6 md:left-1/2 md:-translate-x-1/2 md:w-[95%] md:max-w-7xl md:rounded-full md:px-6 md:py-3 bg-white/70 dark:bg-darkbg/70 backdrop-blur-xl border border-gray-200/50 dark:border-gray-700/50 shadow-sm md:shadow-2xl flex justify-between items-center">
    
    <!-- Logo -->
    <div class="flex-shrink-0 flex items-center group cursor-pointer" id="nav-logo">
        <div class="w-10 h-10 rounded-full bg-gradient-to-br from-primary to-secondary flex items-center justify-center text-white mr-2 transform transition duration-300 group-hover:rotate-12 group-hover:scale-110 shadow-md">
            <i class="fa-solid fa-hands-holding-child text-lg"></i>
        </div>
        <span class="font-extrabold text-2xl tracking-tight bg-clip-text text-transparent bg-gradient-to-r from-primary to-secondary dark:from-blue-400 dark:to-green-400">
            BERSAMAJU
        </span>
    </div>

    <!-- Desktop Menu (App-like Pill Group) -->
    <div class="hidden lg:flex space-x-1 items-center bg-gray-100/60 dark:bg-gray-800/60 p-1.5 rounded-full border border-gray-200/50 dark:border-gray-700/50 backdrop-blur-sm">
        <a href="#tentang" class="flex items-center gap-2 px-5 py-2.5 rounded-full text-sm font-bold text-slate-600 dark:text-gray-300 hover:bg-white dark:hover:bg-darkcard hover:text-primary dark:hover:text-blue-400 hover:shadow-sm transition-all duration-300 group">
            <i class="fa-solid fa-circle-info text-primary/50 dark:text-blue-400/50 group-hover:text-primary dark:group-hover:text-blue-400 transition-colors"></i> Tentang
        </a>
        <a href="#program" class="flex items-center gap-2 px-5 py-2.5 rounded-full text-sm font-bold text-slate-600 dark:text-gray-300 hover:bg-white dark:hover:bg-darkcard hover:text-primary dark:hover:text-blue-400 hover:shadow-sm transition-all duration-300 group">
            <i class="fa-solid fa-laptop-code text-secondary/50 dark:text-green-400/50 group-hover:text-secondary dark:group-hover:text-green-400 transition-colors"></i> Program
        </a>
        <a href="#testimoni" class="flex items-center gap-2 px-5 py-2.5 rounded-full text-sm font-bold text-slate-600 dark:text-gray-300 hover:bg-white dark:hover:bg-darkcard hover:text-primary dark:hover:text-blue-400 hover:shadow-sm transition-all duration-300 group">
            <i class="fa-solid fa-star text-accent/50 dark:text-yellow-400/50 group-hover:text-accent dark:group-hover:text-yellow-400 transition-colors"></i> Testimoni
        </a>
        <a href="#blog" class="flex items-center gap-2 px-5 py-2.5 rounded-full text-sm font-bold text-slate-600 dark:text-gray-300 hover:bg-white dark:hover:bg-darkcard hover:text-primary dark:hover:text-blue-400 hover:shadow-sm transition-all duration-300 group">
            <i class="fa-solid fa-newspaper text-pink-500/50 dark:text-pink-400/50 group-hover:text-pink-500 dark:group-hover:text-pink-400 transition-colors"></i> Blog
        </a>
    </div>

    <!-- Action Buttons (Desktop) -->
    <div class="hidden md:flex items-center space-x-3">
        <!-- Dark Mode Toggle -->
        <button id="theme-toggle" class="w-10 h-10 rounded-full flex items-center justify-center text-gray-500 hover:bg-gray-200 dark:text-gray-400 dark:hover:bg-gray-700 transition-colors focus:outline-none focus:ring-2 focus:ring-primary border border-transparent dark:border-gray-700 bg-gray-100/50 dark:bg-gray-800/50" aria-label="Toggle Dark Mode">
            <i id="theme-toggle-dark-icon" class="fa-solid fa-moon hidden text-lg"></i>
            <i id="theme-toggle-light-icon" class="fa-solid fa-sun hidden text-lg"></i>
        </button>
        
        <button id="btn-login" class="text-slate-700 dark:text-gray-200 font-bold hover:text-primary dark:hover:text-blue-400 transition px-4 py-2.5 rounded-full hover:bg-gray-100/80 dark:hover:bg-gray-800/80">Masuk</button>
        <button id="btn-signup" class="bg-gradient-to-r from-accent to-yellow-400 hover:from-yellow-400 hover:to-yellow-500 text-slate-900 px-6 py-2.5 rounded-full font-bold transition-all shadow-md hover:shadow-lg hover:-translate-y-0.5 focus:ring-4 focus:ring-yellow-300">
            Daftar
        </button>
    </div>

    <!-- Mobile menu button -->
    <div class="md:hidden flex items-center space-x-4">
        <!-- Dark Mode Toggle (Mobile) -->
        <button id="theme-toggle-mobile" class="p-2 text-gray-500 dark:text-gray-400 bg-gray-100/50 dark:bg-gray-800/50 rounded-full w-10 h-10 flex items-center justify-center" aria-label="Toggle Dark Mode">
            <i class="fa-solid fa-moon dark-icon hidden"></i>
            <i class="fa-solid fa-sun light-icon hidden"></i>
        </button>

        <button id="mobile-menu-btn" class="w-10 h-10 bg-gray-100/50 dark:bg-gray-800/50 rounded-full flex items-center justify-center text-gray-600 dark:text-gray-300 hover:text-primary focus:outline-none transition-colors" aria-label="Buka Menu">
            <i id="menu-icon-bars" class="fa-solid fa-bars text-xl transition-transform duration-300"></i>
            <i id="menu-icon-close" class="fa-solid fa-xmark text-xl hidden transition-transform duration-300"></i>
        </button>
    </div>
</nav>

<script>
    // --- Dark Mode Logic ---
    function initTheme() {
        const themeToggleBtn = document.getElementById('theme-toggle');
        const themeToggleMobileBtn = document.getElementById('theme-toggle-mobile');
        const darkIcons = document.querySelectorAll('.fa-moon');
        const lightIcons = document.querySelectorAll('.fa-sun');

        function updateThemeIcons() {
            const isDark = document.documentElement.classList.contains('dark');
            darkIcons.forEach(icon => {
                if (isDark) icon.classList.add('hidden');
                else icon.classList.remove('hidden');
            });
            lightIcons.forEach(icon => {
                if (isDark) icon.classList.remove('hidden');
                else icon.classList.add('hidden');
            });
        }

        function toggleTheme() {
            document.documentElement.classList.toggle('dark');
            if (document.documentElement.classList.contains('dark')) {
                localStorage.setItem('theme', 'dark');
            } else {
                localStorage.setItem('theme', 'light');
            }
            updateThemeIcons();
        }

        themeToggleBtn?.addEventListener('click', toggleTheme);
        themeToggleMobileBtn?.addEventListener('click', toggleTheme);
        updateThemeIcons();

        // Expose for accessibility widget
        window.updateThemeIcons = updateThemeIcons;
    }

    // --- Navbar Scroll Shrink & Glassmorphism ---
    function initNavbarScroll() {
        const navbar = document.getElementById('navbar');
        window.addEventListener('scroll', () => {
            if (window.scrollY > 20) {
                navbar?.classList.add('md:top-3', 'md:py-2', 'shadow-md', 'bg-white/95', 'dark:bg-darkbg/95', 'md:border-gray-200', 'dark:md:border-gray-700');
                navbar?.classList.remove('md:top-6', 'md:py-3', 'shadow-sm', 'bg-white/70', 'dark:bg-darkbg/70', 'md:border-gray-200/50', 'dark:md:border-gray-700/50');
            } else {
                navbar?.classList.add('md:top-6', 'md:py-3', 'shadow-sm', 'bg-white/70', 'dark:bg-darkbg/70', 'md:border-gray-200/50', 'dark:md:border-gray-700/50');
                navbar?.classList.remove('md:top-3', 'md:py-2', 'shadow-md', 'bg-white/95', 'dark:bg-darkbg/95', 'md:border-gray-200', 'dark:md:border-gray-700');
            }
        });
    }

    // --- Logo click scroll to top ---
    function initLogoClick() {
        document.getElementById('nav-logo')?.addEventListener('click', () => {
            window.scrollTo(0, 0);
        });
    }

    // --- Nav button modal triggers ---
    function initNavButtons() {
        document.getElementById('btn-login')?.addEventListener('click', () => {
            window.openModal?.('login');
        });
        document.getElementById('btn-signup')?.addEventListener('click', () => {
            window.openModal?.('signup');
        });
    }

    document.addEventListener('DOMContentLoaded', () => {
        initTheme();
        initNavbarScroll();
        initLogoClick();
        initNavButtons();
    });
</script>
